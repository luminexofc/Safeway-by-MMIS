.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Editor/MCP config (not app code)
opencode.json

# Generated by the graphify tool
graphify-out/
